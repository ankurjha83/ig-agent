# ── Required ────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=          # your key from console.anthropic.com

# ── Discord (Part 2) ─────────────────────────────────────────────────────────
DISCORD_BOT_TOKEN=          # Bot token from discord.com/developers

# ── Instagram (Part 3) ───────────────────────────────────────────────────────
IG_LONG_LIVED_TOKEN=        # Long-lived access token from Meta Graph API
# ig_user_id goes in brands/tru-harvest/brand.json → channels.instagram

# ── GitHub Pages (Part 3) ────────────────────────────────────────────────────
PAGES_BASE_URL=             # e.g. https://<user>.github.io/<repo>

# ── Publishing gate (set true only when fully tested) ────────────────────────
ENABLE_PUBLISH=false

# ── Models (optional overrides) ──────────────────────────────────────────────
ANTHROPIC_MODEL=claude-sonnet-4-5
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL_B=qwen2.5:14b
OLLAMA_MODEL_C=llama3.1:8b
# PRODUCERS=                # JSON list override; leave blank to use defaults above
# STRATEGIST_PROVIDER=anthropic
# STRATEGIST_MODEL=claude-sonnet-4-5

# ── Multi-brand override (optional) ──────────────────────────────────────────
# BRANDS=tru-harvest,brand2  # comma-separated; defaults to all folders in brands/
