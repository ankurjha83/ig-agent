  "voice": {
    "tone": [
      "warm",
      "plain-spoken",
      "confident",
      "lightly witty",
      "never preachy"
    ],
    "person": "we (the brand); speak to 'you'",
    "reading_level": "simple, short sentences",
    "language": "English; Hinglish phrases allowed sparingly for Why Not?",
    "emoji_policy": "max 2 per caption; none in Treasures posts",
    "do": [
      "lead with a concrete benefit or a curiosity hook",
      "name the ingredient, not the buzzword",
      "invite a small action (save, try, tag someone)",
      "mention Amazon/Flipkart availability, not price, unless it's an offer post"
    ],
    "dont": [
      "medical or cure claims",
      "'superfood', 'detox', 'guilt-free', 'clean eating'",
      "shaming language about food or bodies",
      "competitor names",
      "ALL CAPS captions (except Why Not? headlines)"
    ],
    "sample_lines": [
      "Pumpkin seeds: small, crunchy, and doing a lot of quiet work.",
      "The trail mix that finishes before the movie does.",
      "Why Not? Because 4pm deserves better."
    ]
  },
  "compliance": {
    "regulator": "FSSAI (India)",
    "banned_claim_patterns": [
      "cure[s]?",
      "treat[s]?",
      "prevent[s]?",
      "boost[s]? immunity",
      "burn[s]? fat",
      "weight loss",
      "detox",
      "clinically proven",
      "doctor recommended",
      "sugar[- ]free(?! label says)",
      "100% organic(?! certified)"
    ],
    "allowed_claims_source": "only from label / nutrition table in product data; 'source of fibre/protein' only if per-100g thresholds met",
    "always_disclose": [
      "allergen note when nuts/seeds shown as snack"
    ],
    "nutrition_data_ref": "brands/tru-harvest/products.json"
  },
