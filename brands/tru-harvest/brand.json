      },
      "headline": {
        "family": "Poppins",
        "weight": "700",
        "case": "sentence",
        "note": "matches bold black product names on jar labels"
      },
      "body": {
        "family": "Poppins",
        "weight": "400"
      },
      "label_caps": {
        "family": "Poppins",
        "weight": "300",
        "case": "upper",
        "tracking": "+15%",
        "note": "'PREMIUM QUALITY' style"
