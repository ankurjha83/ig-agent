      "style": "natural light, warm, top-down or 45°, real textures (wood, linen, stone), Indian kitchen context welcome",
      "avoid": [
        "neon",
        "clinical white studio",
        "cluttered props",
        "stock-looking hands"
      ],
      "real_product_library": "product images/ (repo root) — pouch mockups: Mamra almonds, foxtail millet, lal masoor, flax seeds; jar mockups: cranberries, blueberries, hazelnuts, brazil nuts, trail mix",
