    "packaging_systems": {
      "note": "Two live systems observed Aug 2026. Guardian must pick the right one per product line.",
      "green_pouch": {
        "lines": [
          "seeds",
          "pulses",
          "millets",
          "staple nuts (e.g. Mamra almonds)"
        ],
        "look": "white upper panel with light-grey farm line-sketch, large forest-green two-line wordmark + bright leaf, '100% NATURAL FOODS' tagline, forest-green product-name band with English | Hindi name, deep-green lower panel"
      },
      "colorway_jar": {
        "lines": [
          "dried berries",
          "premium nuts",
          "trail mix"
        ],
        "look": "transparent PET jar; label = product colorway background with subtle darker swirl, white rounded logo tile (compact wordmark), white dashed rule, white rounded panel with flat-vector product illustration + bold black product name, 'PREMIUM QUALITY' in spaced caps"
      }
    },
    "illustration": {
      "style": "flat vector, 2–3 tone, soft highlight, no outlines — matches jar-label product art",
      "source": "Claude-generated SVG per post, palette-locked to brand vars; stored in assets/illustrations/",
      "never": "photoreal AI images of packaging"
    },
    "stock": {
      "providers": [
        "pexels",
        "unsplash"
      ],
      "use": "ambience only (kitchen, table, textures); must be reviewed like any asset"
